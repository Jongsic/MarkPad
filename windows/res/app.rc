// App icon (generated from the shared icon set in design/), the
// PerMonitorV2 DPI + Common Controls v6 manifest, and version info.
1 ICON "MarkPad.ico"
2 ICON "MarkPadDoc.ico"   // document icon for .md file associations
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,3,1,0
PRODUCTVERSION 1,3,1,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MarkPad - Markdown viewer & editor"
      VALUE "FileVersion", "1.3.1.0"
      VALUE "ProductName", "MarkPad"
      VALUE "ProductVersion", "1.3.1.0"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "MarkPad.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
